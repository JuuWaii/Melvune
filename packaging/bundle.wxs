<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="FnMusic 0.2.0-rc.1" Manufacturer="FnMusic contributors" Version="0.1.999.0" UpgradeCode="725BF993-538D-44B0-B1B4-227B1230B13F">
    <Variable Name="InstallFolder" Type="string" Value="[LocalAppDataFolder]Programs\FnMusic" bal:Overridable="yes" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="https://github.com/JuuWaii/fnmusic_pc/blob/master/LICENSE" SuppressOptionsUI="yes" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)" Compressed="yes" Visible="no" ForcePerMachine="no">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
