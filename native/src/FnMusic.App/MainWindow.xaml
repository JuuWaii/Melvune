<Window x:Class="FnMusic.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Root_Loaded">
  <Grid.Resources><ResourceDictionary>
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="SliderThumbBackground" Color="#202020"/>
   <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#202020"/>
   <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#202020"/>
   <SolidColorBrush x:Key="SliderTrackValueFill" Color="#202020"/>
   <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#202020"/>
   <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#202020"/>
   <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#202020"/>
   <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#202020"/>
   <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="White"/>
   <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="White"/>
   <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="White"/>

   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#202020"/>
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#404040"/>
   <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#606060"/>
   <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White"/>
   <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#202020"/>
   <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#404040"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="SliderThumbBackground" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="SliderTrackValueFill" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#101010"/>
   <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#101010"/>
   <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#101010"/>

   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#CCCCCC"/>
   <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#AAAAAA"/>
   <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#101010"/>
   <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E5E5E5"/>
   <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#CCCCCC"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
  </ResourceDictionary></Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="24">
   <StackPanel Spacing="12">
    <FontIcon Glyph="&#xE8D6;" FontSize="36" HorizontalAlignment="Left" />
    <TextBlock Text="飞牛音乐" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock Text="Windows 原生客户端" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <TextBlock Text="音乐导航" FontWeight="SemiBold" />
    <Button Content="所有音乐" Click="Library_Click" HorizontalAlignment="Stretch"/><Button Content="收藏" Click="SidebarFavorites_Click" HorizontalAlignment="Stretch"/><Button Content="专辑" Click="SidebarAlbums_Click" HorizontalAlignment="Stretch"/><Button Content="歌手" Click="SidebarArtists_Click" HorizontalAlignment="Stretch"/>
    <Button Content="本地音乐" Click="LocalMusic_Click" />
    <Button Content="导入文件夹" Click="ImportLocal_Click" />
    <TextBlock x:Name="LocalScanStatus" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
    <Button x:Name="CancelLocalScan" Content="取消扫描" Visibility="Collapsed" Click="CancelLocalScan_Click" />
    <Button Content="连接与账号" Click="Settings_Click" />
    <TextBlock Text="跟随系统 · 浅色 / 深色" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   </StackPanel>
  </Border>
  <ScrollViewer x:Name="SettingsPanel" Grid.Column="1" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
   <StackPanel Margin="32" Spacing="20">
    <TextBlock x:Uid="SettingsTitle" Style="{ThemeResource TitleTextBlockStyle}" />
    <TextBlock Text="连接 NAS，管理你的登录状态。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
     <StackPanel Spacing="16">
      <TextBox x:Uid="ServerAddress" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button x:Uid="ConnectButton" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Click="Connect_Click" Style="{ThemeResource AccentButtonStyle}" />
     </StackPanel>
    </Border>
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
     <StackPanel Spacing="16">
      <TextBlock Text="{x:Bind ViewModel.Account, Mode=OneWay}" FontWeight="SemiBold" />
      <TextBox x:Uid="Username" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <PasswordBox x:Name="PasswordInput" x:Uid="Password" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" />
      <CheckBox x:Uid="RememberSession" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" IsChecked="{x:Bind ViewModel.RememberSession, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="12">
       <Button x:Uid="LoginButton" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Click="Login_Click" Style="{ThemeResource AccentButtonStyle}" />
       <Button x:Uid="LogoutButton" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Click="Logout_Click" />
      </StackPanel>
     </StackPanel>
    </Border>
    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="NAS 授权登录与 FN Connect 远程访问正在适配。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="LibraryPanel" Grid.Column="1" Margin="24" RowSpacing="16" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="12">
    <TextBlock Text="音乐，陪伴每一个时刻" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="浏览你的音乐资料库，或从本地文件夹开始聆听。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="歌曲" Click="Songs_Click"/>
     <Button Content="收藏" Click="Favorites_Click"/>
     <Button Content="专辑" Click="Albums_Click"/>
     <Button Content="歌手" Click="Artists_Click"/>
     <Button x:Name="CollectionBack" Content="返回列表" Click="CollectionBack_Click" Visibility="Collapsed"/>
     <Button x:Name="CollectionOpen" Content="查看详情" Click="CollectionOpen_Click" Visibility="Collapsed"/>
     <Button x:Name="ArtistAlbums" Content="歌手专辑" Click="ArtistAlbums_Click" Visibility="Collapsed"/>
    </StackPanel>
    <TextBlock x:Name="CollectionHeading" TextWrapping="Wrap" Visibility="Collapsed"/>
    <Grid ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="SearchInput" PlaceholderText="搜索歌曲" AutomationProperties.Name="搜索歌曲" MaxLength="256"/>
     <Button Grid.Column="1" Content="搜索" Click="Search_Click"/>
     <Button Grid.Column="2" Content="清空搜索" Click="ClearSearch_Click"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="刷新曲库" Click="Refresh_Click"/>
     <Button x:Name="PreviousPage" Content="上一页" Click="Previous_Click" IsEnabled="False"/>
     <Button x:Name="NextPage" Content="下一页" Click="Next_Click" IsEnabled="False"/>
     <TextBlock x:Name="PageStatus" VerticalAlignment="Center"/><Button x:Name="FavoriteToggle" Content="收藏歌曲" IsEnabled="False" Click="Favorite_Click"/><TextBlock x:Name="FavoriteStatus" VerticalAlignment="Center"/>
    </StackPanel>
   </StackPanel>

   <Border x:Name="LyricsPanel" Grid.Row="1" Grid.Column="1" Width="300" Margin="16,0,0,0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="Collapsed"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="歌词" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock x:Name="LyricsStatus" Grid.Row="1" Text="播放歌曲后显示歌词。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ListView x:Name="LyricsList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Lyric_ItemClick"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="17" Margin="4,12"/></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
   <ListView x:Name="CollectionList" Grid.Row="1" SelectionMode="Single" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="Collection_ItemClick">
    <ListView.ItemTemplate><DataTemplate>
     <Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="72" Height="72" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE93C;"/><Image Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <ListView x:Name="TrackList" Grid.Row="1" SelectionMode="Single" SelectionChanged="TrackSelection_Changed">
    <ListView.ItemTemplate><DataTemplate>
     <Grid Padding="8" ColumnSpacing="16" Background="Transparent" DoubleTapped="Track_DoubleTapped">
      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="20"/><Image Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding DisplayDuration}" HorizontalAlignment="Right"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,12">
   <Grid ColumnSpacing="20" RowSpacing="6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" Width="64" Height="64"><Grid><FontIcon Glyph="&#xE8D6;"/><Image x:Name="NowCover" Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="NowPlaying" Text="选择歌曲，开始聆听" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowAlbum" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><Button Content="歌词 / 正在播放" Click="Lyrics_Click" Padding="8,3"/></StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Stretch">
     <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
      <Button Content="上一首" Click="PreviousTrack_Click"/>
      <Button Content="播放所选" Click="PlaySelected_Click"/>
      <Button Content="暂停" Click="Pause_Click"/>
      <Button Content="继续" Click="Resume_Click"/>
      <Button Content="下一首" Click="NextTrack_Click"/>
      <Button Content="停止" Click="Stop_Click"/>
     </StackPanel>
     <Slider x:Name="SeekSlider" AutomationProperties.Name="播放进度" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="Seek_Changed"/>
     <TextBlock x:Name="PlaybackTime" Text="0:00 / 0:00" FontSize="12" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Spacing="4">
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="队列" Click="ManageQueue_Click"/><ComboBox x:Name="QueueModePicker" AutomationProperties.Name="播放模式" SelectedIndex="0" SelectionChanged="QueueMode_Changed"><ComboBoxItem Content="顺序播放"/><ComboBoxItem Content="列表循环"/><ComboBoxItem Content="单曲循环"/><ComboBoxItem Content="随机播放"/></ComboBox></StackPanel>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox x:Name="MuteToggle" Content="静音" Click="Mute_Click"/><Slider Grid.Column="1" x:Name="VolumeSlider" AutomationProperties.Name="音量" Minimum="0" Maximum="100" Value="50" ValueChanged="Volume_Changed"/></Grid>
    </StackPanel>
    <TextBlock x:Name="PlaybackStatus" Grid.Row="1" Grid.ColumnSpan="2" Text="选择本地音乐或连接飞牛开始播放。" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="QueueStatus" Grid.Row="2" Grid.ColumnSpan="2" Text="播放队列为空" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
    <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Content="音频输出设备" HorizontalAlignment="Right">
     <Button.Flyout><Flyout><StackPanel Spacing="8"><ComboBox x:Name="OutputDevices" Header="音频输出设备" MinWidth="240" DisplayMemberPath="Name" SelectionChanged="Output_Changed"/><Button Content="刷新设备" Click="Devices_Click"/></StackPanel></Flyout></Button.Flyout>
    </Button>
   </Grid>
  </Border>
 </Grid>
</Window>
