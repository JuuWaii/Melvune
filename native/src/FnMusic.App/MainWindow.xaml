<Window x:Class="FnMusic.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="WindowRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar">
   <TitleBar.Resources><HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment><x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double></TitleBar.Resources>
   <TitleBar.LeftHeader><StackPanel x:Name="TitleBrand" Width="196" Margin="14,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image x:Name="TitleBrandIcon" Source="ms-appx:///Assets/FnMusic.png" Width="28" Height="28" AutomationProperties.Name="FnMusic 图标"/><TextBlock x:Name="TitleBrandName" Text="飞牛音乐" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></TitleBar.LeftHeader>
   <TitleBar.Content><Grid x:Name="TopNavigation" Width="480" ColumnSpacing="6" Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="TopBack" Width="32" Height="32" Padding="6" Click="TopBack_Click" AutomationProperties.Name="返回" ToolTipService.ToolTip="返回"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
    <TextBox x:Name="SearchInput" Grid.Column="1" PlaceholderText="搜索音乐" AutomationProperties.Name="搜索音乐" MaxLength="256" MinWidth="64"/>
    <Button x:Name="SearchAction" Grid.Column="2" Width="32" Height="32" Padding="6" Click="Search_Click" AutomationProperties.Name="搜索音乐" ToolTipService.ToolTip="搜索音乐"><FontIcon Glyph="&#xE721;" FontSize="14"/></Button>
    <Button x:Name="ClearSearchAction" Grid.Column="3" Width="32" Height="32" Padding="6" Click="ClearSearch_Click" AutomationProperties.Name="清空搜索" ToolTipService.ToolTip="清空搜索"><FontIcon Glyph="&#xE894;" FontSize="14"/></Button>
    <ProgressRing x:Name="MetadataActivity" Grid.Column="4" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="后台加载音乐资料" ToolTipService.ToolTip="正在后台加载音乐资料…"/>
   </Grid></TitleBar.Content>
   <TitleBar.RightHeader><Button x:Name="TitleBarSettings" Click="Settings_Click" Width="36" Height="32" Padding="6" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button></TitleBar.RightHeader>
  </TitleBar>
 <Grid x:Name="Root" Grid.Row="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Root_Loaded">
  <Grid.Resources>
   <DataTemplate x:Key="SidebarPlaylistTemplate">
    <Grid MinHeight="36" Padding="6,4" ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image x:Name="NasPlaylistWatermark" Grid.ColumnSpan="2" Loaded="PlaylistWatermark_Loaded" Width="68" Height="36" HorizontalAlignment="Right" Stretch="Uniform" Opacity="0.18" Visibility="{Binding NasVisibility}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
     <FontIcon Glyph="&#xE8F1;" FontSize="14" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="PlaylistManagerCardTemplate">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8" MinHeight="84">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image x:Name="NasPlaylistWatermark" Grid.ColumnSpan="3" Loaded="PlaylistWatermark_Loaded" Width="100" Height="56" HorizontalAlignment="Right" Margin="0,0,150,0" Opacity="0.14" Visibility="{Binding NasVisibility}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
      <FontIcon Glyph="&#xE8F1;" FontSize="24" VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Tag="open" Click="PlaylistManagerAction_Click" IsEnabled="{Binding CanOpen}" Width="36" Height="36" Padding="8" AutomationProperties.Name="打开歌单" ToolTipService.ToolTip="打开歌单"><FontIcon Glyph="&#xE8A7;" FontSize="16"/></Button>
       <Button Tag="rename" Click="PlaylistManagerAction_Click" IsEnabled="{Binding CanWrite}" Width="36" Height="36" Padding="8" AutomationProperties.Name="重命名歌单" ToolTipService.ToolTip="重命名歌单"><FontIcon Glyph="&#xE70F;" FontSize="16"/></Button>
       <Button Tag="delete" Click="PlaylistManagerAction_Click" IsEnabled="{Binding CanWrite}" Width="36" Height="36" Padding="8" AutomationProperties.Name="删除歌单" ToolTipService.ToolTip="删除歌单"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
   <DataTemplate x:Key="LocalLibraryCardTemplate">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,8" MinHeight="92">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="44" Height="44" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center"><FontIcon Glyph="&#xE8B7;" FontSize="24"/></Border>
      <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Directory}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{Binding Group}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
       <Button Click="LibraryCardEdit_Click" Width="36" Height="36" Padding="8" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="编辑音乐库" ToolTipService.ToolTip="编辑音乐库"><FontIcon Glyph="&#xE70F;" FontSize="16"/></Button>
       <Button Click="LibraryCardDelete_Click" Width="36" Height="36" Padding="8" IsEnabled="{Binding CanDelete}" AutomationProperties.Name="删除音乐库" ToolTipService.ToolTip="删除音乐库"><FontIcon Glyph="&#xE74D;" FontSize="16"/></Button>
      </StackPanel>
     </Grid>
    </Border>
   </DataTemplate>
   <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="32"/><Setter Property="Padding" Value="4"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="16"/>
   </Style>
   <Style x:Key="PlayerAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinWidth" Value="44"/>
    <Setter Property="Padding" Value="4"/><Setter Property="CornerRadius" Value="22"/><Setter Property="BorderThickness" Value="0"/>
   </Style>
   <DataTemplate x:Key="SongRowTemplate">
    <Grid Height="60" Padding="8" ColumnSpacing="16" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="20"/><Image Stretch="UniformToFill" Loaded="SongArtwork_Loaded" DataContextChanged="SongArtwork_DataContextChanged" EffectiveViewportChanged="SongArtwork_ViewportChanged" Unloaded="SongArtwork_Unloaded"/></Grid></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding BrowseArtist}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding Album}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding DisplayDuration}" HorizontalAlignment="Right"/>
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="QueueTrackTemplate">
    <Grid ColumnSpacing="10" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="18"/><Image Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon x:Name="QueueCurrentMarker" Glyph="&#xE768;" FontSize="12" Visibility="Collapsed" AutomationProperties.Name="当前歌曲"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/></Grid><TextBlock Text="{Binding BrowseArtist}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <TextBlock Grid.Column="2" Text="{Binding DisplayDuration}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
   </DataTemplate>
  </Grid.Resources>
  <Grid.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="NowPlayingEscape_Invoked"/></Grid.KeyboardAccelerators>

  <ContentControl x:Name="NormalContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="SidebarHost" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,16,8,16"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="SidebarScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
   <StackPanel x:Name="SidebarContent" Spacing="8" Margin="0,0,20,0">
    <TextBlock Text="音乐浏览" Margin="8,8,0,2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Content="首页" Click="Home_Click" HorizontalAlignment="Stretch"/>
    <Button x:Name="AllMusicNavigation" Content="所有音乐" Click="AllMusic_Click" HorizontalAlignment="Stretch"/><Button x:Name="RemoteFavoritesNavigation" Content="收藏" Click="SidebarFavorites_Click" HorizontalAlignment="Stretch"/><Button x:Name="RemoteAlbumsNavigation" Content="专辑" Click="SidebarAlbums_Click" HorizontalAlignment="Stretch"/><Button x:Name="RemoteArtistsNavigation" Content="歌手" Click="SidebarArtists_Click" HorizontalAlignment="Stretch"/>
    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Grid x:Name="MergedPlaylistHeader" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlaylistsNavigation" Content="歌单" Click="MusicPlaylists_Click" HorizontalAlignment="Stretch"/><Button x:Name="NewPlaylistNavigation" Grid.Column="1" Click="NewLocalPlaylist_Click" AutomationProperties.Name="新建歌单" ToolTipService.ToolTip="新建本地歌单；同步歌单可在音乐管理中新建"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button></Grid>
    <ListView x:Name="UnifiedPlaylistNavigation" ItemTemplate="{StaticResource SidebarPlaylistTemplate}" ContextRequested="UnifiedPlaylist_ContextRequested" ContextCanceled="TrackContext_Canceled" SelectionMode="Single" MaxHeight="360" IsItemClickEnabled="True" ItemClick="UnifiedPlaylist_ItemClick" AutomationProperties.Name="歌单导航"/>
    <TextBlock x:Name="UnifiedPlaylistStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <StackPanel x:Name="SidebarGroupedPlaylists" Visibility="Collapsed" Spacing="8">
     <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="飞牛歌单" Click="MusicPlaylists_Click" HorizontalAlignment="Stretch"/><Button x:Name="NewNasPlaylist" Grid.Column="1" Click="NewNasPlaylist_Click" AutomationProperties.Name="新建飞牛歌单" ToolTipService.ToolTip="新建飞牛同步歌单"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button></Grid>
     <ListView x:Name="GroupedNasPlaylistNavigation" ItemTemplate="{StaticResource SidebarPlaylistTemplate}" ContextRequested="UnifiedPlaylist_ContextRequested" ContextCanceled="TrackContext_Canceled" SelectionMode="Single" MaxHeight="220" IsItemClickEnabled="True" ItemClick="UnifiedPlaylist_ItemClick" AutomationProperties.Name="飞牛歌单分类"/>
     <TextBlock x:Name="GroupedNasPlaylistStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
     <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="其他歌单" Click="MusicPlaylists_Click" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Click="NewLocalPlaylist_Click" AutomationProperties.Name="新建其他歌单" ToolTipService.ToolTip="新建本地跨库歌单"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button></Grid>
     <ListView x:Name="GroupedOtherPlaylistNavigation" ItemTemplate="{StaticResource SidebarPlaylistTemplate}" ContextRequested="UnifiedPlaylist_ContextRequested" ContextCanceled="TrackContext_Canceled" SelectionMode="Single" MaxHeight="220" IsItemClickEnabled="True" ItemClick="UnifiedPlaylist_ItemClick" AutomationProperties.Name="其他歌单分类"/>
     <TextBlock x:Name="GroupedOtherPlaylistStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <!-- Compatibility models for source-specific editors; the visible navigation is unified. -->
    <StackPanel Visibility="Collapsed">
     <Button x:Name="RemotePlaylistsNavigation" Content="飞牛歌单" Click="NasPlaylists_Click"/>
     <ListView x:Name="NasPlaylistNavigation"/><TextBlock x:Name="NasPlaylistNavigationStatus"/>
     <ListView x:Name="LocalPlaylistNavigation"/><TextBlock x:Name="LocalPlaylistNavigationStatus"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel x:Name="SidebarFooter" Grid.Row="1" Spacing="8" Margin="0,12,20,0">
   <TextBlock x:Name="LocalScanStatus" TextWrapping="Wrap" FontSize="12" MaxLines="2" AutomationProperties.LiveSetting="Polite"/>
   <Button x:Name="CancelLocalScan" Content="取消扫描" Visibility="Collapsed" Click="CancelLocalScan_Click" />
   <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
   <Button x:Name="MusicManagementNavigation" Content="音乐管理" Click="ManageMusic_Click" HorizontalAlignment="Stretch"/>
  </StackPanel>
 </Grid></Border><ScrollViewer x:Name="SettingsPanel" Grid.Column="1" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
   <StackPanel Margin="32" Spacing="20">
    <TextBlock x:Uid="SettingsTitle" Style="{ThemeResource TitleTextBlockStyle}" />
    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><SelectorBar x:Name="SettingsCategories" SelectionChanged="SettingsCategory_Changed">
     <SelectorBarItem x:Name="ConnectionCategory" Text="连接与账号"/><SelectorBarItem x:Name="AppearanceCategory" Text="外观"/><SelectorBarItem x:Name="PlaybackCategory" Text="播放"/><SelectorBarItem x:Name="LibrariesCategory" Text="音乐库与素材库"/>
    </SelectorBar></ScrollViewer>
    <StackPanel x:Name="SettingsConnectionSection" Spacing="20">
    <TextBlock Text="连接 NAS，管理你的登录状态。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
     <StackPanel Spacing="16">
      <TextBox x:Uid="ServerAddress" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Text="{x:Bind ViewModel.ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button x:Uid="ConnectButton" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Click="Connect_Click" Style="{ThemeResource AccentButtonStyle}" />
     </StackPanel>
    </Border>
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
     <StackPanel Spacing="16">
      <TextBlock Text="{x:Bind ViewModel.Account, Mode=OneWay}" FontWeight="SemiBold" />
      <TextBox x:Uid="Username" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <PasswordBox x:Name="PasswordInput" x:Uid="Password" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" />
      <CheckBox x:Uid="RememberSession" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" IsChecked="{x:Bind ViewModel.RememberSession, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="12">
       <Button x:Uid="LoginButton" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Click="Login_Click" Style="{ThemeResource AccentButtonStyle}" />
       <Button x:Uid="LogoutButton" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" Click="Logout_Click" />
      </StackPanel>
     </StackPanel>
    </Border>
    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="FNMusic 0.2.0-rc.7 · 非官方客户端。使用 FFmpeg（LGPL 2.1 或更高版本）；对应源码与许可证随包提供，见 licenses 目录。FN Connect 与 OAuth 后续支持。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel x:Name="SettingsAppearanceSection" Visibility="Collapsed" Spacing="16">
     <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="12">
      <ComboBox x:Name="ThemePicker" Header="颜色模式" AutomationProperties.Name="外观模式" HorizontalAlignment="Stretch" SelectionChanged="Theme_Changed"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
      <TextBlock Text="跟随系统会自动响应 Windows 的浅色和深色设置。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ToggleSwitch x:Name="SeparateNasPlaylistsToggle" Header="飞牛歌单单独分组" Toggled="PlaylistGrouping_Toggled"/><TextBlock Text="开启时将飞牛歌单与其他歌单分类显示；关闭时合并显示。两种模式均保留飞牛歌单。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="SettingsPlaybackSection" Visibility="Collapsed" Spacing="16">
     <TextBlock Text="播放" FontSize="20" FontWeight="SemiBold"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="16">
      <TextBlock Text="音量" FontWeight="SemiBold"/><Slider x:Name="SettingsVolume" Minimum="0" Maximum="100" Value="{Binding Value, ElementName=VolumeSlider, Mode=TwoWay}" AutomationProperties.Name="播放音量"/>
      <ToggleButton x:Name="SettingsMute" Content="静音" IsChecked="{Binding IsChecked, ElementName=MuteToggle, Mode=TwoWay}" Click="SettingsMute_Click" HorizontalAlignment="Left"/>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SettingsModeButton" Content="播放模式" Click="SettingsMode_Click"/><TextBlock x:Name="SettingsModeSummary" Grid.Column="1" VerticalAlignment="Center"/></Grid>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="SettingsOutputButton" Content="音频输出设备" Click="SettingsOutput_Click"/><TextBlock Grid.Column="1" Text="{Binding SelectedItem.Name, ElementName=OutputDevices}" VerticalAlignment="Center" TextWrapping="Wrap"/></Grid>
      <TextBlock x:Name="SettingsOutputStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></Border>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="桌面播放联动" FontWeight="SemiBold"/>
      <ToggleSwitch x:Name="SystemMediaEnabled" Header="SMTC 开关" Toggled="DesktopIntegration_Toggled"/><TextBlock Text="在 Windows 媒体面板显示歌曲，并响应系统媒体按键的播放、暂停和切歌。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ToggleSwitch x:Name="DesktopLyricsEnabled" Header="显示桌面歌词" Toggled="DesktopIntegration_Toggled"/>
      <ToggleSwitch x:Name="DesktopLyricsTopmost" Header="歌词置顶" Toggled="DesktopOptions_Changed"/>
      <ToggleSwitch x:Name="DesktopLyricsLocked" Header="锁定并穿透鼠标（可在此解锁）" Toggled="DesktopOptions_Changed"/>
      <Slider x:Name="DesktopLyricsFont" Header="歌词字号" Minimum="16" Maximum="64" Value="28" ValueChanged="DesktopFont_Changed"/>
      <ComboBox x:Name="DesktopLyricsTheme" Header="歌词颜色模式" SelectionChanged="DesktopTheme_Changed"><ComboBoxItem Content="跟随主窗口"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
      <Button Content="解锁并找回歌词窗口" Click="RecoverDesktopLyrics_Click" HorizontalAlignment="Left"/>
      <TextBlock Text="第三方应用接入" FontWeight="SemiBold" Margin="0,12,0,0"/><ToggleSwitch x:Name="InformationEnabled" Header="允许本机应用读取播放信息与歌词" Toggled="DesktopIntegration_Toggled"/>
      <TextBlock Text="供支持 FNMusic 协议的本机应用读取歌曲、播放进度和完整歌词，只读且不控制播放。默认关闭，关闭后停止服务并移除发现记录；与 Windows SMTC 媒体控制互相独立。" TextWrapping="Wrap"/>
      <TextBlock x:Name="IntegrationStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></Border>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="桌面常驻" FontWeight="SemiBold"/>
      <ToggleSwitch x:Name="ShellTrayEnabled" Header="系统托盘" IsOn="True" Toggled="DesktopShell_Toggled"/>
      <ToggleSwitch x:Name="ShellCloseToTray" Header="关闭窗口时收起到托盘" Toggled="DesktopShell_Toggled"/>
      <TextBlock Text="首次关闭时选择收起或退出，可记住选择；也可在此更改。收起后播放和歌词继续，从托盘菜单选择「退出」可结束应用。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ToggleSwitch x:Name="ShellHotkeysEnabled" Header="全局播放与歌词快捷键" Toggled="DesktopShell_Toggled"/>
      <TextBlock Text="Ctrl + Alt + 空格：播放/暂停；← / →：上一首/下一首；L：显示/隐藏桌面歌词；U：解锁并找回歌词。各组合均按住 Ctrl + Alt。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="ShellStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></Border>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="睡眠定时" FontWeight="SemiBold"/>
      <ComboBox x:Name="SleepTimerDuration" Header="停止播放前的时间" SelectedIndex="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="15 分钟"/><ComboBoxItem Content="30 分钟"/><ComboBoxItem Content="60 分钟"/><ComboBoxItem Content="90 分钟"/></ComboBox>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="开始定时" Click="SleepTimerStart_Click"/><Button x:Name="SleepTimerCancel" Content="取消定时" IsEnabled="False" Click="SleepTimerCancel_Click"/></StackPanel>
      <TextBlock x:Name="SleepTimerStatus" Text="未设置睡眠定时。" TextWrapping="Wrap"/>
      <TextBlock Text="重新开始会替换旧定时。暂停、切歌或收起窗口时仍继续计时；重启应用后不恢复定时。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel></Border>
    </StackPanel>
    <StackPanel x:Name="SettingsLibrariesSection" Visibility="Collapsed" Spacing="16">
     <TextBlock Text="音乐库与素材库" FontSize="20" FontWeight="SemiBold"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="12"><TextBlock Text="本地音乐库" FontWeight="SemiBold"/><TextBlock Text="管理文件夹、分组和扫描；本地歌单可混合不同来源的歌曲。" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="管理音乐库" Click="ManageLocalLibraries_Click"/><Button Content="新建音乐库" Click="ImportLocal_Click"/></StackPanel></StackPanel></Border>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="24"><StackPanel Spacing="12"><TextBlock Text="飞牛服务器" FontWeight="SemiBold"/><TextBlock Text="素材库、服务器设置和后台任务同步到已登录的飞牛账号，权限由服务器决定。" TextWrapping="Wrap"/><Button x:Name="RemoteSettingsNavigation" Content="飞牛素材库与设置" Click="NasSettings_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Grid x:Name="HomePanel" Grid.Column="1" Margin="24" Visibility="Collapsed"><StackPanel Spacing="20"><TextBlock Text="音乐，陪伴每一个时刻" TextWrapping="Wrap" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="浏览你的音乐资料库，或从本地文件夹开始聆听。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="所有音乐汇集飞牛与本地歌曲，可在页面内筛选来源；歌单在左侧合并显示，也可在音乐管理中单独分组。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="浏览音乐" Click="AllMusic_Click"/><Button Content="连接与账号" Click="ConnectionSettings_Click"/></StackPanel><Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock Text="正在播放" FontWeight="SemiBold"/><TextBlock Text="{Binding Text, ElementName=NowPlaying}" TextWrapping="Wrap"/><Button Content="打开歌词" Click="Lyrics_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></Grid>
  <ContentControl x:Name="PlaylistPanel" Grid.Column="1" Margin="24" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid x:Name="LibraryPanel" Grid.Column="1" Margin="24" RowSpacing="16" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="LibraryHeaderScroll" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="CollectionBack" Content="返回列表" Click="CollectionBack_Click" Visibility="Collapsed"/>
     <Button x:Name="CollectionOpen" Content="查看详情" Click="CollectionOpen_Click" Visibility="Collapsed"/>
     <Button x:Name="ArtistAlbums" Content="歌手专辑" Click="ArtistAlbums_Click" Visibility="Collapsed"/>
    </StackPanel></ScrollViewer>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="BrowseSourceFilter" Header="来源" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="BrowseSource_Changed"><ComboBoxItem Content="全部来源"/><ComboBoxItem Content="飞牛音乐"/><ComboBoxItem Content="本地音乐"/><ComboBoxItem Content="Navidrome"/><ComboBoxItem Content="Emby"/><ComboBoxItem Content="Subsonic 兼容源"/><ComboBoxItem Content="自定义 HTTP/JSON"/></ComboBox>
     <Grid x:Name="LocalLibraryFilters" Grid.Column="1" Visibility="Collapsed" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="LocalGroupFilter" Header="本地分组" HorizontalAlignment="Stretch" SelectionChanged="LocalFilter_Changed"/><ComboBox x:Name="LocalLibraryFilter" Grid.Column="1" Header="本地音乐库" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="LocalFilter_Changed"/></Grid>
    </Grid>
    <TextBlock x:Name="CollectionHeading" TextWrapping="Wrap" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="刷新曲库" Click="Refresh_Click"/>
     <Button x:Name="PreviousPage" Content="上一页" Click="Previous_Click" IsEnabled="False"/>
     <Button x:Name="NextPage" Content="下一页" Click="Next_Click" IsEnabled="False"/>
     <Button x:Name="FavoriteToggle" Content="收藏歌曲" IsEnabled="False" Visibility="Collapsed" Click="Favorite_Click"/>
     <Button x:Name="TrackActionsButton" Content="更多操作" IsEnabled="False" Click="TrackActions_Click" ToolTipService.ToolTip="歌曲操作：右键歌曲或 Shift+F10"/>
    </StackPanel><TextBlock x:Name="PageStatus" TextTrimming="CharacterEllipsis"/>
    <Grid x:Name="BrowseScanProgress" Visibility="{Binding Visibility, ElementName=CancelLocalScan}" ColumnSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="BrowseScanStatus" Text="{Binding Text, ElementName=LocalScanStatus}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     <Button x:Name="BrowseCancelLocalScan" Grid.Column="1" Content="取消扫描" Click="CancelLocalScan_Click"/>
    </Grid><TextBlock x:Name="FavoriteStatus" TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer>

   <ListView x:Name="CollectionList" Grid.Row="1" SelectionMode="Single" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="Collection_ItemClick">
    <ListView.ItemTemplate><DataTemplate>
     <Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="72" Height="72" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xE93C;"/><Image Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel></Grid>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <ListView x:Name="TrackList" Grid.Row="1" SelectionMode="Single" SelectionChanged="TrackSelection_Changed" ContextRequested="TrackList_ContextRequested" ContextCanceled="TrackContext_Canceled">
   </ListView>
  </Grid>
  <Border x:Name="PlayerBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,10">
   <Grid x:Name="PlayerLayout" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NowPlayingColumn" Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PlayerRightColumn" Width="270"/></Grid.ColumnDefinitions>
    <Grid x:Name="NowPlayingDetails" ColumnSpacing="10" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button x:Name="NowCoverButton" Width="56" Height="56" Padding="0" CornerRadius="8" Click="Lyrics_Click" AutomationProperties.Name="打开或关闭全屏歌词" ToolTipService.ToolTip="全屏歌词 / 正在播放"><Grid><FontIcon Glyph="&#xE8D6;"/><Image x:Name="NowCover" Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Button>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="NowPlaying" Text="选择歌曲，开始聆听" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NowAlbum" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
       <Button x:Name="PlaybackInfoButton" Grid.Column="1" Width="20" Height="20" MinWidth="20" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="查看播放状态" ToolTipService.ToolTip="{Binding Text, ElementName=PlaybackStatus}"><FontIcon Glyph="&#xE946;" FontSize="12"/>
        <Button.Flyout><Flyout><StackPanel MaxWidth="320" Spacing="8"><TextBlock Text="播放状态" FontWeight="SemiBold"/><TextBlock x:Name="PlaybackInfoStatus" TextWrapping="Wrap"/><TextBlock x:Name="PlaybackInfoQueue" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Flyout></Button.Flyout>
       </Button>
      </Grid>
     </StackPanel>
    </Grid>
    <Grid x:Name="TransportPanel" Grid.ColumnSpan="3" ColumnSpacing="12" RowSpacing="4" HorizontalAlignment="Stretch">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="TransportLeftColumn" Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="TransportRightColumn" Width="270"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="TransportButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button x:Name="QueueModeButton" Style="{StaticResource PlayerIconButtonStyle}" AutomationProperties.Name="播放模式：顺序播放" ToolTipService.ToolTip="播放模式：顺序播放">
       <FontIcon x:Name="QueueModeIcon" Glyph="&#xE72A;" FontSize="16"/>
       <Button.Flyout><MenuFlyout><ToggleMenuFlyoutItem x:Name="SequentialModeItem" Text="顺序播放" Tag="Sequential" IsChecked="True" Click="QueueMode_Click"/><ToggleMenuFlyoutItem x:Name="RepeatAllModeItem" Text="列表循环" Tag="RepeatAll" Click="QueueMode_Click"/><ToggleMenuFlyoutItem x:Name="RepeatOneModeItem" Text="单曲循环" Tag="RepeatOne" Click="QueueMode_Click"/><ToggleMenuFlyoutItem x:Name="ShuffleModeItem" Text="随机播放" Tag="Shuffle" Click="QueueMode_Click"/></MenuFlyout></Button.Flyout>
      </Button>
      <Button x:Name="PreviousTrackButton" Style="{StaticResource PlayerIconButtonStyle}" Click="PreviousTrack_Click" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首"><FontIcon Glyph="&#xE892;" FontSize="16"/></Button>
      <Button x:Name="PlayPauseButton" Style="{StaticResource PlayerAccentButtonStyle}" Click="PlayPause_Click" AutomationProperties.Name="播放" ToolTipService.ToolTip="播放"><FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="22"/></Button>
      <Button x:Name="NextTrackButton" Style="{StaticResource PlayerIconButtonStyle}" Click="NextTrack_Click" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首"><FontIcon Glyph="&#xE893;" FontSize="16"/></Button>
      <Button x:Name="StopButton" Style="{StaticResource PlayerIconButtonStyle}" Click="Stop_Click" AutomationProperties.Name="停止" ToolTipService.ToolTip="停止"><FontIcon Glyph="&#xE71A;" FontSize="16"/></Button>
     </StackPanel>
     <StackPanel x:Name="PlayerOptionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
      <ToggleButton x:Name="DesktopLyricsShortcut" Width="32" Height="32" MinWidth="32" Padding="4" CornerRadius="16" BorderThickness="0" Click="DesktopLyricsShortcut_Click" AutomationProperties.Name="显示桌面歌词" ToolTipService.ToolTip="显示桌面歌词"><TextBlock Text="词" FontSize="16" FontWeight="SemiBold"/></ToggleButton>
      <Button x:Name="OutputDeviceButton" Style="{StaticResource PlayerIconButtonStyle}" AutomationProperties.Name="音频输出设备" ToolTipService.ToolTip="音频输出设备"><FontIcon Glyph="&#xE7F6;" FontSize="16"/>
       <Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="360"><ComboBox x:Name="OutputDevices" Header="音频输出设备" MinWidth="240" DisplayMemberPath="Name" SelectionChanged="Output_Changed"/><TextBlock x:Name="OutputStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/><Button Content="刷新设备" Click="Devices_Click"/></StackPanel></Flyout></Button.Flyout>
      </Button>
      <ToggleButton x:Name="MuteToggle" Width="32" Height="32" MinWidth="32" Padding="4" CornerRadius="16" BorderThickness="0" Click="Mute_Click" AutomationProperties.Name="静音" ToolTipService.ToolTip="静音"><FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16"/></ToggleButton>
      <Slider x:Name="VolumeSlider" Width="88" VerticalAlignment="Center" AutomationProperties.Name="音量" Minimum="0" Maximum="100" Value="50" ValueChanged="Volume_Changed"/>
      <Button x:Name="QueueButton" Style="{StaticResource PlayerIconButtonStyle}" Click="ManageQueue_Click" AutomationProperties.Name="打开播放队列" ToolTipService.ToolTip="播放队列"><FontIcon Glyph="&#xE8FD;" FontSize="16"/></Button>
     </StackPanel>
     <Grid x:Name="PlayerProgress" Grid.Row="1" Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="PlaybackTime" Text="00:00" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="已播放时间"/>
      <Slider x:Name="SeekSlider" Grid.Column="1" AutomationProperties.Name="播放进度" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="Seek_Changed"/>
      <TextBlock x:Name="PlaybackDuration" Grid.Column="2" Text="00:00" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="总时长"/>
     </Grid>
    </Grid>
    <TextBlock x:Name="PlaybackStatus" Visibility="Collapsed" Text="选择本地音乐或连接飞牛开始播放。" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="QueueStatus" Visibility="Collapsed" Text="播放队列为空"/>
   </Grid>
  </Border>
  </Grid></ContentControl>
  <ContentControl x:Name="LyricsInteractionHost" Canvas.ZIndex="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid x:Name="LyricsPanel" Grid.ColumnSpan="2" Grid.RowSpan="2" Padding="32,20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed" RowSpacing="20" Canvas.ZIndex="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="NowPlayingBack" Click="NowPlayingBack_Click" AutomationProperties.Name="返回原页面" ToolTipService.ToolTip="返回原页面 (Escape)"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70D;" FontSize="16"/><TextBlock Text="返回"/></StackPanel></Button>
    <TextBlock Grid.Column="1" Text="正在播放" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <Grid Grid.Row="1" ColumnSpacing="32" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="FullPlayerColumn" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Stretch" MaxWidth="480">
     <StackPanel Spacing="12">
      <Border x:Name="FullArtworkPanel" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Center" Width="380" Height="380"><Grid><FontIcon Glyph="&#xE8D6;" FontSize="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Image x:Name="FullNowCover" Stretch="UniformToFill" Loaded="Artwork_Loaded" DataContextChanged="Artwork_DataContextChanged" Unloaded="Artwork_Unloaded"/></Grid></Border>
      <StackPanel Spacing="4"><TextBlock x:Name="FullNowTitle" Text="尚未播放歌曲" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="FullNowArtist" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
      <ContentControl x:Name="FullTransportHost" HorizontalContentAlignment="Stretch"/>
      <TextBlock Text="{Binding Text, ElementName=PlaybackStatus}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="FullLyricsText" Grid.Column="1" Grid.RowSpan="2" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="LyricsStatus" Text="播放歌曲后显示歌词。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
     <ListView x:Name="LyricsList" Grid.Row="1" VerticalAlignment="Center" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Lyric_ItemClick" ContainerContentChanging="Lyric_ContainerContentChanging" AutomationProperties.Name="歌曲歌词"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="22" Margin="8,14"/></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
   </Grid>
  </Grid>
  </ContentControl>
  <ContentControl x:Name="FullPageHost" Canvas.ZIndex="4" Padding="24,20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed">
   <ContentControl.Template>
    <ControlTemplate TargetType="ContentControl">
     <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
      <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
     </Border>
    </ControlTemplate>
   </ContentControl.Template>
  </ContentControl>
  <Grid x:Name="QueueOverlay" Canvas.ZIndex="5" Visibility="Collapsed">
   <Border Background="Transparent" PointerPressed="QueueBackdrop_PointerPressed"/>
   <Border x:Name="QueuePane" Width="420" HorizontalAlignment="Right" Margin="8" Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" TabFocusNavigation="Cycle">
    <ContentControl x:Name="QueuePaneHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Border>
  </Grid>
  <TextBlock x:Name="MetadataNotice" Canvas.ZIndex="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,8,16,0" MaxWidth="420" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
 </Grid>
</Window>
