<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Melvune.App' Or '$(MSBuildProjectName)' == 'Melvune.SeekProbe'">
    <MelvuneUsesNativeDecoder>true</MelvuneUsesNativeDecoder>
    <MelvuneDecoderRoot>$(MSBuildThisFileDirectory)../.tools/native-decoder/build</MelvuneDecoderRoot>
  </PropertyGroup>
  <Import Project="$(MelvuneDecoderRoot)/decoder.props" Condition="'$(MelvuneUsesNativeDecoder)' == 'true' And Exists('$(MelvuneDecoderRoot)/decoder.props')" />

  <Target Name="VerifyMelvuneNativeDecoder" BeforeTargets="PrepareForBuild" Condition="'$(MelvuneUsesNativeDecoder)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(MelvuneDecoderDecoderSha256)' == '' Or !Exists('$(MelvuneDecoderRoot)/FFmpegInteropX.dll') Or !Exists('$(MelvuneDecoderRoot)/build-manifest.json')" Text="Pinned MP3 preroll decoder is missing. Restore native/Melvune.sln, then run python scripts/build-native-decoder.py." />
    <GetFileHash Files="$(MSBuildThisFileDirectory)decoder/mp3-preroll.patch" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="MelvunePatchHash" /></GetFileHash>
    <GetFileHash Files="$(MSBuildThisFileDirectory)../scripts/build-native-decoder.py" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="MelvuneScriptHash" /></GetFileHash>
    <GetFileHash Files="$(MSBuildThisFileDirectory)decoder/toolchain-lock.json" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="MelvuneLockHash" /></GetFileHash>
    <GetFileHash Files="$(MelvuneDecoderRoot)/FFmpegInteropX.dll" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="MelvuneDecoderHash" /></GetFileHash>
    <Error Condition="'%(MelvunePatchHash.FileHash)' != '$(MelvuneDecoderPatchSha256)'" Text="Native decoder patch changed. Run python scripts/build-native-decoder.py." />
    <Error Condition="'%(MelvuneScriptHash.FileHash)' != '$(MelvuneDecoderScriptSha256)'" Text="Native decoder build script changed. Run python scripts/build-native-decoder.py." />
    <Error Condition="'%(MelvuneLockHash.FileHash)' != '$(MelvuneDecoderLockSha256)'" Text="Native decoder dependency lock changed. Run python scripts/build-native-decoder.py." />
    <Error Condition="'%(MelvuneDecoderHash.FileHash)' != '$(MelvuneDecoderDecoderSha256)'" Text="Native decoder DLL changed. Run python scripts/build-native-decoder.py." />
  </Target>

  <Target Name="CopyMelvuneNativeDecoder" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="VerifyMelvuneNativeDecoder" Condition="'$(MelvuneUsesNativeDecoder)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(MelvuneDecoderRoot)/FFmpegInteropX.dll;$(MelvuneDecoderRoot)/build-manifest.json" DestinationFiles="$(TargetDir)FFmpegInteropX.dll;$(TargetDir)native-decoder-build.json" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishMelvuneNativeDecoder" AfterTargets="Publish" DependsOnTargets="VerifyMelvuneNativeDecoder" Condition="'$(MelvuneUsesNativeDecoder)' == 'true'">
    <Copy SourceFiles="$(MelvuneDecoderRoot)/FFmpegInteropX.dll;$(MelvuneDecoderRoot)/build-manifest.json" DestinationFiles="$(PublishDir)FFmpegInteropX.dll;$(PublishDir)native-decoder-build.json" SkipUnchangedFiles="true" />
  </Target>
</Project>
