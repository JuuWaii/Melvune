<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FnMusic.Infrastructure/FnMusic.Infrastructure.csproj" />
    <ProjectReference Include="../../examples/FnMusic.InfoClient/FnMusic.InfoClient.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyIndependentInformationClient" AfterTargets="Build">
    <ItemGroup><InformationClientFiles Include="../../examples/FnMusic.InfoClient/bin/$(Configuration)/net10.0-windows/*.*" /></ItemGroup>
    <Copy SourceFiles="@(InformationClientFiles)" DestinationFolder="$(OutDir)info-client" />
  </Target>
</Project>
